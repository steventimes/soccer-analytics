  "behavior": {
    "archive_attempts": 4,
    "archive_backoff_factor_seconds": 1.0,
    "attempts_exhausted": "When a retryable failure exhausts attempts, do not wait; preserve DataSourceError for clients and the original requests exception for archives, attaching any parsed hint. Permanent HTTP errors stop immediately without parsing retry hints.",
    "client_attempts": "max_retries + 1",
    "client_backoff_factor_seconds": 0.25,
    "default_max_delay_seconds": 60.0,
    "fallback": "Uniform full jitter from zero through min(max_delay, backoff_factor * 2^retry_index); scaled exponent avoids intermediate overflow.",
    "fractional_seconds": "Accepted for compatibility with the prior client; RFC9110 itself specifies integer delay-seconds.",
    "freshness": "Existing training snapshots require explicit --refresh. Recent collection uses a new directory unless --resume is explicit; no automatic TTL or stale response fallback.",
    "network_failures_retried": true,
    "over_limit_with_attempts_remaining": "No further request or sleep; DataSourceError for clients, RetryAfterLimitError(requests.RequestException) for archives, both with retry_after_seconds.",
    "rate_hooks": "Each actual attempt preserves its existing limiter accounting or archive before_request hook.",
    "response_lifecycle": "Close failed HTTP responses before waits/errors. Successfully returned public responses and archive streams remain caller-owned.",
    "retryable_status_codes": [
      429,
      500,
      502,
      503,
      504
    ],
    "server_hint": "Nonnegative seconds or HTTP date precede fallback; never jitter or shorten a valid wait."
  },
